{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "open_in_iina_ytdlp@iina.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "Download to IINA",
  "description": "Downloads video/audio with yt-dlp to ~/Downloads, then opens the file in IINA.",
  "version": "1.2.1",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Download to IINA",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  },
  "homepage_url": "https://github.com/justinluque/iina-ytdlp-extension"
}
