{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "open_in_iina_ytdlp@iina.io",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "name": "Download to IINA",
  "description": "Downloads video/audio with yt-dlp to ~/Downloads, then opens the file in IINA.",
  "version": "1.2.2",
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "Download to IINA",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": false
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "storage"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "homepage_url": "https://github.com/justinluque/download-to-iina"
}
