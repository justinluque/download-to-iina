{
  "manifest_version": 2,
  "browser_specific_settings": {
    "gecko": {
      "id": "open_in_iina_ytdlp@iina.io",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "name": "Download & Open in IINA (yt-dlp)",
  "description": "Downloads video/audio with yt-dlp to ~/Downloads, then opens the file in IINA.",
  "version": "1.0.0",
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_icon": "icon.png",
    "default_title": "Download & Open in IINA"
  },
  "permissions": [
    "tabs",
    "activeTab",
    "contextMenus",
    "nativeMessaging"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
